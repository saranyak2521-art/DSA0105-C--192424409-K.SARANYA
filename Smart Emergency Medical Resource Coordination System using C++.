=====================================================================*/
#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

const int MAX = 20;

/*=====================================================================
  ABSTRACT BASE CLASS : Resource
  Demonstrates: private/protected members, static members,
  pure virtual functions, virtual destructor, operator+ overload
=====================================================================*/
class Resource {
protected:
    int resourceId;
    string resourceName;
    int capacity;
    bool available;
    static int totalResourcesRegistered;   // shared count
    static int totalAvailableCapacity;     // shared capacity pool

public:
    Resource() : resourceId(0), resourceName("Unknown"), capacity(0), available(true) {
        totalResourcesRegistered++;
    }
    Resource(int id, string name, int cap)
        : resourceId(id), resourceName(name), capacity(cap), available(true) {
        totalResourcesRegistered++;
        totalAvailableCapacity += cap;
    }
    Resource(const Resource &r)
        : resourceId(r.resourceId), resourceName(r.resourceName),
          capacity(r.capacity), available(r.available) {
        totalResourcesRegistered++;
        if (available) totalAvailableCapacity += capacity;
    }

    // Pure virtual functions -> makes Resource an abstract class
    virtual void displayInfo() const = 0;
    virtual double computeUtilizationScore() const = 0;
    virtual string getType() const = 0;

    void markAllocated() {
        if (available) {
            available = false;
            totalAvailableCapacity -= capacity;
        }
    }
    void markReleased() {
        if (!available) {
            available = true;
            totalAvailableCapacity += capacity;
        }
    }
    bool isAvailable() const { return available; }
    int getId() const { return resourceId; }
    string getName() const { return resourceName; }
    int getCapacity() const { return capacity; }

    // Operator overload 1: combine capacities of two resources
    int operator+(const Resource &r) const {
        return capacity + r.capacity;
    }

    static int getTotalResources() { return totalResourcesRegistered; }
    static int getTotalCapacity()  { return totalAvailableCapacity; }

    virtual ~Resource() {
        if (available) totalAvailableCapacity -= capacity;
        totalResourcesRegistered--;
        cout << "  [Destructor] Resource '" << resourceName << "' released.\n";
    }
};
int Resource::totalResourcesRegistered = 0;
int Resource::totalAvailableCapacity = 0;

/*=====================================================================
  Intermediate classes for VIRTUAL BASE CLASS demonstration
  MobileUnit and Trackable both virtually inherit Resource so that
  Ambulance (which inherits both) has only ONE copy of Resource.
=====================================================================*/
class MobileUnit : public virtual Resource {
protected:
    int speedKmph;
public:
    MobileUnit() : speedKmph(0) {}
    MobileUnit(int speed) : speedKmph(speed) {}
    void showMobility() const { cout << "  Speed: " << speedKmph << " km/h\n"; }
};

class Trackable : public virtual Resource {
protected:
    bool gpsEnabled;
public:
    Trackable() : gpsEnabled(false) {}
    Trackable(bool gps) : gpsEnabled(gps) {}
    void showTracking() const {
        cout << "  GPS Tracking: " << (gpsEnabled ? "Enabled" : "Disabled") << "\n";
    }
};

/*=====================================================================
  Ambulance : diamond hierarchy resolved through virtual inheritance
=====================================================================*/
class Ambulance : public MobileUnit, public Trackable {
private:
    string equipmentLevel;
public:
    Ambulance()
        : Resource(), MobileUnit(), Trackable(), equipmentLevel("Basic") {}

    Ambulance(int id, string name, int cap, int speed, bool gps, string level)
        : Resource(id, name, cap), MobileUnit(speed), Trackable(gps), equipmentLevel(level) {}

    Ambulance(const Ambulance &a)
        : Resource(a), MobileUnit(a.speedKmph), Trackable(a.gpsEnabled),
          equipmentLevel(a.equipmentLevel) {}

    void displayInfo() const {
        cout << "[Ambulance] ID:" << resourceId << " Name:" << resourceName
             << " Capacity:" << capacity << " Level:" << equipmentLevel
             << " Status:" << (available ? "Available" : "Allocated") << "\n";
        showMobility();
        showTracking();
    }
    double computeUtilizationScore() const {
        return (speedKmph * 0.4) + (capacity * 5) + (gpsEnabled ? 10 : 0);
    }
    string getType() const { return "Ambulance"; }

    ~Ambulance() { cout << "  [Destructor] Ambulance '" << resourceName << "' finalized.\n"; }
};

/*=====================================================================
  Bed : simple single inheritance, concrete resource
=====================================================================*/
class Bed : public Resource {
private:
    string wardType;
public:
    Bed() : Resource(), wardType("General") {}
    Bed(int id, string name, int cap, string ward) : Resource(id, name, cap), wardType(ward) {}

    void displayInfo() const {
        cout << "[Bed] ID:" << resourceId << " Name:" << resourceName
             << " Ward:" << wardType << " Capacity:" << capacity
             << " Status:" << (available ? "Available" : "Allocated") << "\n";
    }
    double computeUtilizationScore() const {
        return capacity * (wardType == "ICU" ? 8 : 4);
    }
    string getType() const { return "Bed"; }
    ~Bed() { cout << "  [Destructor] Bed '" << resourceName << "' finalized.\n"; }
};

/*=====================================================================
  EquipmentUnit : shows the design is extensible (new type added easily)
=====================================================================*/
class EquipmentUnit : public Resource {
private:
    string equipmentName;
public:
    EquipmentUnit() : Resource(), equipmentName("Ventilator") {}
    EquipmentUnit(int id, string name, int cap, string eq)
        : Resource(id, name, cap), equipmentName(eq) {}

    void displayInfo() const {
        cout << "[Equipment] ID:" << resourceId << " Name:" << resourceName
             << " Unit:" << equipmentName << " Capacity:" << capacity
             << " Status:" << (available ? "Available" : "Allocated") << "\n";
    }
    double computeUtilizationScore() const { return capacity * 6; }
    string getType() const { return "Equipment"; }
    ~EquipmentUnit() {
        cout << "  [Destructor] Equipment '" << resourceName << "' finalized.\n";
    }
};

/*=====================================================================
  Patient class
=====================================================================*/
class Patient {
private:
    int patientId;
    string name;
    int age;
    string condition;
    int severity;   // 1 (mild) - 10 (critical)
public:
    Patient() : patientId(0), name("N/A"), age(0), condition("N/A"), severity(1) {}
    Patient(int id, string nm, int ag, string cond, int sev)
        : patientId(id), name(nm), age(ag), condition(cond), severity(sev) {}
    Patient(const Patient &p)
        : patientId(p.patientId), name(p.name), age(p.age),
          condition(p.condition), severity(p.severity) {}

    Patient& operator=(const Patient &p) {
        if (this != &p) {
            patientId = p.patientId;
            name = p.name;
            age = p.age;
            condition = p.condition;
            severity = p.severity;
        }
        return *this;
    }

    void display() const {
        cout << "Patient ID:" << patientId << " Name:" << name << " Age:" << age
             << " Condition:" << condition << " Severity:" << severity << "\n";
    }
    int getSeverity() const { return severity; }
    string getName() const { return name; }
    int getId() const { return patientId; }
};

/*=====================================================================
  EmergencyCase class -> holds a base-class pointer to allocated Resource
  Demonstrates: base class pointer, operator overload 2 (priority compare)
=====================================================================*/
class EmergencyCase {
private:
    int caseId;
    Patient patient;
    Resource* allocatedResource;   // base class pointer -> polymorphism
    int priorityScore;
    bool active;
    static int activeCaseCount;

public:
    EmergencyCase() : caseId(0), allocatedResource(NULL), priorityScore(0), active(false) {}

    EmergencyCase(int id, Patient p, int priority)
        : caseId(id), patient(p), allocatedResource(NULL),
          priorityScore(priority), active(true) {
        activeCaseCount++;
    }
    EmergencyCase(const EmergencyCase &c)
        : caseId(c.caseId), patient(c.patient), allocatedResource(c.allocatedResource),
          priorityScore(c.priorityScore), active(c.active) {
        if (active) activeCaseCount++;
    }

    // Assignment operator kept consistent with the static active-case counter
    // (needed because array elements are populated via assignment)
    EmergencyCase& operator=(const EmergencyCase &other) {
        if (this != &other) {
            if (active) activeCaseCount--;
            caseId = other.caseId;
            patient = other.patient;
            allocatedResource = other.allocatedResource;
            priorityScore = other.priorityScore;
            active = other.active;
            if (active) activeCaseCount++;
        }
        return *this;
    }

    void allocateResource(Resource* r) {
        allocatedResource = r;
        if (r) r->markAllocated();
    }

    void closeCase() {
        if (active) { active = false; activeCaseCount--; }
        if (allocatedResource) allocatedResource->markReleased();
        cout << "Case " << caseId << " closed.\n";
    }

    // Operator overload 2: compare case priority ( > )
    bool operator>(const EmergencyCase &other) const {
        return priorityScore > other.priorityScore;
    }

    void displayCase() const {
        cout << "Case ID:" << caseId << " | ";
        patient.display();
        cout << "  Priority Score:" << priorityScore
             << " | Status:" << (active ? "Active" : "Closed") << "\n";
        if (allocatedResource) {
            cout << "  Allocated -> ";
            allocatedResource->displayInfo();   // runtime polymorphism
        } else {
            cout << "  Allocated -> None\n";
        }
    }
    int getPriority() const { return priorityScore; }
    int getCaseId() const { return caseId; }
    bool isActive() const { return active; }
    Resource* getAllocatedResource() const { return allocatedResource; }
    static int getActiveCases() { return activeCaseCount; }

    ~EmergencyCase() {
        if (active) activeCaseCount--;
    }
};
int EmergencyCase::activeCaseCount = 0;

/*=====================================================================
  Utility / modular functions
=====================================================================*/
double calculateBilling(const EmergencyCase &c, const Resource *r) {
    if (!r) return 0.0;
    return r->computeUtilizationScore() * 1.5 + c.getPriority() * 2;
}

void generateReport(Patient patients[], int pCount, Resource* resources[], int rCount,
                     EmergencyCase cases[], int cCount) {
    cout << "\n================ COORDINATION REPORT ================\n";
    cout << "Total Patients Registered : " << pCount << "\n";
    cout << "Total Resources Registered: " << Resource::getTotalResources() << "\n";
    cout << "Total Emergency Capacity  : " << Resource::getTotalCapacity() << "\n";
    cout << "Active Emergency Cases    : " << EmergencyCase::getActiveCases() << "\n";
    cout << "-------------------------------------------------------\n";
    cout << "Patients:\n";
    for (int i = 0; i < pCount; i++) patients[i].display();
    cout << "-------------------------------------------------------\n";
    cout << "Resources:\n";
    for (int i = 0; i < rCount; i++) resources[i]->displayInfo();
    cout << "-------------------------------------------------------\n";
    cout << "Emergency Cases:\n";
    for (int i = 0; i < cCount; i++) cases[i].displayCase();
    cout << "=======================================================\n";
}

/*=====================================================================
  MENU-DRIVEN MAIN PROGRAM
=====================================================================*/
int main() {
    Patient patients[MAX];
    int patientCount = 0;

    Resource* resources[MAX];   // array of base-class pointers
    int resourceCount = 0;

    EmergencyCase cases[MAX];
    int caseCount = 0;

    int choice;
    do {
        cout << "\n===== Smart Emergency Medical Resource Coordination System =====\n";
        cout << "1. Register Patient\n";
        cout << "2. Register Resource (Ambulance/Bed/Equipment)\n";
        cout << "3. View All Resources\n";
        cout << "4. Create Emergency Case & Allocate Resource\n";
        cout << "5. Compare Priority of Two Cases\n";
        cout << "6. Update Resource Status\n";
        cout << "7. Calculate Utilization Score / Billing\n";
        cout << "8. Combine Capacity of Two Resources (operator+)\n";
        cout << "9. Generate Coordination Report\n";
        cout << "0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
        case 1: {
            if (patientCount >= MAX) { cout << "Patient list full.\n"; break; }
            string name, cond; int age, sev;
            cout << "Name: "; cin >> name;
            cout << "Age: "; cin >> age;
            cout << "Condition: "; cin >> cond;
            cout << "Severity (1-10): "; cin >> sev;
            patients[patientCount] = Patient(patientCount + 1, name, age, cond, sev);
            cout << "Patient registered with ID " << patients[patientCount].getId() << "\n";
            patientCount++;
            break;
        }
        case 2: {
            if (resourceCount >= MAX) { cout << "Resource list full.\n"; break; }
            int type; string name; int cap;
            cout << "Type (1-Ambulance 2-Bed 3-Equipment): "; cin >> type;
            cout << "Name: "; cin >> name;
            cout << "Capacity: "; cin >> cap;
            int id = resourceCount + 1;
            if (type == 1) {
                int speed; bool gps; string level;
                cout << "Speed (km/h): "; cin >> speed;
                cout << "GPS enabled (1/0): "; cin >> gps;
                cout << "Equipment Level: "; cin >> level;
                resources[resourceCount] = new Ambulance(id, name, cap, speed, gps, level);
            } else if (type == 2) {
                string ward;
                cout << "Ward Type (ICU/General): "; cin >> ward;
                resources[resourceCount] = new Bed(id, name, cap, ward);
            } else if (type == 3) {
                string eq;
                cout << "Equipment Name: "; cin >> eq;
                resources[resourceCount] = new EquipmentUnit(id, name, cap, eq);
            } else {
                cout << "Invalid resource type.\n";
                break;
            }
            cout << "Resource registered with ID " << id << "\n";
            resourceCount++;
            break;
        }
        case 3: {
            for (int i = 0; i < resourceCount; i++)
                resources[i]->displayInfo(); // polymorphism
            break;
        }
        case 4: {
            if (patientCount == 0 || resourceCount == 0) {
                cout << "Register patient & resource first.\n"; break;
            }
            int pid;
            cout << "Enter Patient ID: "; cin >> pid;
            Patient *p = NULL;
            for (int i = 0; i < patientCount; i++)
                if (patients[i].getId() == pid) p = &patients[i];
            if (!p) { cout << "Patient not found.\n"; break; }

            int priority = p->getSeverity() * 10;
            cases[caseCount] = EmergencyCase(caseCount + 1, *p, priority);

            Resource *chosen = NULL;
            for (int i = 0; i < resourceCount; i++)
                if (resources[i]->isAvailable()) { chosen = resources[i]; break; }

            if (chosen) {
                cases[caseCount].allocateResource(chosen);
                cout << "Allocated " << chosen->getType() << " (ID "
                     << chosen->getId() << ") to case.\n";
            } else {
                cout << "No available resource currently.\n";
            }
            cout << "Case created with priority score: " << priority << "\n";
            caseCount++;
            break;
        }
        case 5: {
            int c1, c2;
            cout << "Enter first Case ID: "; cin >> c1;
            cout << "Enter second Case ID: "; cin >> c2;
            if (c1 < 1 || c1 > caseCount || c2 < 1 || c2 > caseCount) {
                cout << "Invalid case ID.\n"; break;
            }
            EmergencyCase &a = cases[c1 - 1], &b = cases[c2 - 1];
            if (a > b) cout << "Case " << c1 << " has HIGHER priority.\n";
            else if (b > a) cout << "Case " << c2 << " has HIGHER priority.\n";
            else cout << "Both cases have EQUAL priority.\n";
            break;
        }
        case 6: {
            int rid, status;
            cout << "Enter Resource ID: "; cin >> rid;
            cout << "Set status (1-Available 0-Allocated): "; cin >> status;
            bool found = false;
            for (int i = 0; i < resourceCount; i++)
                if (resources[i]->getId() == rid) {
                    if (status == 1) resources[i]->markReleased();
                    else resources[i]->markAllocated();
                    found = true;
                }
            cout << (found ? "Resource status updated.\n" : "Resource not found.\n");
            break;
        }
        case 7: {
            int cid;
            cout << "Enter Case ID: "; cin >> cid;
            if (cid < 1 || cid > caseCount) { cout << "Invalid case ID.\n"; break; }
            EmergencyCase &c = cases[cid - 1];
            Resource *r = c.getAllocatedResource();
            if (r) {
                cout << fixed << setprecision(2);
                cout << "Utilization Score (" << r->getType() << "): "
                     << r->computeUtilizationScore() << "\n";     // virtual call
                cout << "Billing Amount: Rs. " << calculateBilling(c, r) << "\n";
            } else {
                cout << "No resource allocated to this case yet.\n";
            }
            break;
        }
        case 8: {
            int id1, id2;
            cout << "Enter first Resource ID: "; cin >> id1;
            cout << "Enter second Resource ID: "; cin >> id2;
            Resource *r1 = NULL, *r2 = NULL;
            for (int i = 0; i < resourceCount; i++) {
                if (resources[i]->getId() == id1) r1 = resources[i];
                if (resources[i]->getId() == id2) r2 = resources[i];
            }
            if (r1 && r2)
                cout << "Combined Capacity = " << (*r1 + *r2) << "\n"; // operator+
            else cout << "Resource(s) not found.\n";
            break;
        }
        case 9: {
            generateReport(patients, patientCount, resources,
                            resourceCount, cases, caseCount);
            break;
        }
        case 0:
            cout << "Exiting system...\n";
            break;
        default:
            cout << "Invalid choice.\n";
        }
    } while (choice != 0);

    // Release all dynamically allocated resources via base class pointer
    for (int i = 0; i < resourceCount; i++)
        delete resources[i]; // virtual destructor chain

    return 0;
}
